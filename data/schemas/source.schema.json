{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casetracker-ai.example/schemas/source.schema.json",
  "title": "CaseTracker Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "caseId", "sourceType", "title", "verificationStatus", "retrievedAt", "confidenceScore", "notes"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "caseId": { "type": "string", "format": "uuid" },
    "sourceType": { "enum": ["court_record", "official_statement", "news_report", "public_record", "transcript", "recording", "document", "social_media", "other"] },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": ["string", "null"], "format": "uri" },
    "citation": { "type": ["string", "null"] },
    "publication": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "publishDate": { "type": ["string", "null"], "format": "date" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "verificationStatus": { "enum": ["unreviewed", "in_review", "supported", "partially_supported", "conflicted", "unsupported", "rejected"] },
    "confidenceScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "An aid to triage, not a truth score or substitute for human review." },
    "reviewer": { "type": ["string", "null"] },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
    "rightsNotes": { "type": "string" },
    "notes": { "type": "string" }
  }
}
